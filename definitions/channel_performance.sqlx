config {
  type: "incremental",
  schema: "attribution",
  name: "channel_performance",
  description: "Daily channel performance using DISTINCT transaction_id for conversions",
  uniqueKey: ["date", "channel"],
  bigquery: {
    partitionBy: "date",
    clusterBy: ["channel"],
    updatePartitionFilter: "date >= DATE_SUB(CURRENT_DATE('America/Los_Angeles'), INTERVAL 7 DAY)"
  },
  tags: ["attribution", "ga4", "last-click"]
}

-- ============================================================================
-- 渠道每日表现汇总表（Last Click Attribution）- 增量更新版
-- ============================================================================

WITH 
-- 1. 提取所有事件 (Raw Extraction)
Session_Raw AS (
  SELECT
    user_pseudo_id,
    (SELECT value.int_value FROM UNNEST(event_params) WHERE key = 'ga_session_id') AS session_id,
    DATE(TIMESTAMP_MICROS(event_timestamp), "America/Los_Angeles") AS date,
    (SELECT value.string_value FROM UNNEST(event_params) WHERE key = 'session_engaged') AS session_engaged_param,
    
    session_traffic_source_last_click.cross_channel_campaign.default_channel_group AS default_channel_group,

    LOWER(COALESCE(
      session_traffic_source_last_click.cross_channel_campaign.source,
      (SELECT value.string_value FROM UNNEST(event_params) WHERE key = 'source'),
      '(direct)'
    )) AS session_source,
    
    LOWER(COALESCE(
      session_traffic_source_last_click.cross_channel_campaign.medium,
      (SELECT value.string_value FROM UNNEST(event_params) WHERE key = 'medium'),
      '(none)'
    )) AS session_medium,
    
    LOWER(COALESCE(
      session_traffic_source_last_click.cross_channel_campaign.campaign_name,
      (SELECT value.string_value FROM UNNEST(event_params) WHERE key = 'campaign'),
      '(not set)'
    )) AS session_campaign,
    
    LOWER((SELECT value.string_value FROM UNNEST(event_params) WHERE key = 'page_location')) AS page_location,
    
    event_name,
    ecommerce.transaction_id,
    COALESCE(ecommerce.purchase_revenue_in_usd, 0) AS purchase_revenue_in_usd
  FROM
    ${ref('analytics_489554557', 'events_*')}
  WHERE
    -- 增量逻辑
    ${when(incremental(),
      `_TABLE_SUFFIX >= FORMAT_DATE('%Y%m%d', DATE_SUB(CURRENT_DATE("America/Los_Angeles"), INTERVAL 1 DAY))`,
      `_TABLE_SUFFIX >= FORMAT_DATE('%Y%m%d', DATE_SUB(CURRENT_DATE("America/Los_Angeles"), INTERVAL 90 DAY))`
    )}
),

-- 2. [新增] 预计算标记层 (Session_With_Flags)
-- 将付费流量判断逻辑统一，供后续逻辑调用
Session_With_Flags AS (
  SELECT
    *,
    CASE 
      -- A. 强信号：Campaign 后缀 (最高优先级)
      WHEN REGEXP_CONTAINS(session_campaign, r'-aw|-cs|-cv|-rt') THEN TRUE
      
      -- B. 强信号：Source 特殊匹配
      WHEN REGEXP_CONTAINS(session_source, r'capitaloneshopping') THEN TRUE
      
      -- C. 强信号：Medium 包含明确的付费标识
      WHEN REGEXP_CONTAINS(session_medium, r'^(cpc|ppc|display|cpm|banner)$') THEN TRUE
      WHEN session_medium LIKE '%paid%' THEN TRUE
      
      -- D. 弱信号修正：Medium 为 'shopping' 或 'video' 时，必须结合 Channel Group 判断
      WHEN session_medium IN ('video', 'shopping') 
           AND default_channel_group IN ('Paid Shopping', 'Paid Video', 'Paid Search', 'Display') THEN TRUE
           
      ELSE FALSE
    END AS is_paid_traffic
  FROM Session_Raw
),

-- 3. 基础渠道映射 (Base Mapping)
Session_Base_Mapped AS (
  SELECT
    *,
    
    CASE
      -- [修正] Pillar Page 逻辑：必须同时满足 URL 规则 AND 是付费流量
      WHEN is_paid_traffic 
           AND REGEXP_CONTAINS(session_campaign, r'-aw|-cs|-cv|-rt')
           AND REGEXP_CONTAINS(page_location, r'/pages/(what-is-an-ebike|cruiser-ebike|folding-ebike|city-ebike|fat-tire-ebike)')
      THEN 'pillar page'

      -- 标准渠道分类
      WHEN default_channel_group = 'Affiliates'
        OR REGEXP_CONTAINS(session_medium, r'affiliate|avantlink|uppromote|goaffpro|impact')
        OR REGEXP_CONTAINS(session_source, r'affiliate|avantlink|uppromote|goaffpro|impact')
        THEN 'affiliates'

      WHEN default_channel_group = 'SMS'
        OR REGEXP_CONTAINS(session_medium, r'sms')
        THEN 'sms'

      WHEN default_channel_group = 'Email'
        OR REGEXP_CONTAINS(session_source, r'klaviyo|email|substack|wunderkind')
        OR session_medium = 'edm'
        THEN 'email'

      WHEN REGEXP_CONTAINS(session_medium, r'kol')
        OR session_source = 'kol'
        THEN 'kol'

      WHEN session_medium = 'programmatic'
        OR REGEXP_CONTAINS(session_source, r'ttd|outbrain|loopme|criteo|tradedesk')
        THEN 'programmatic ads'

      WHEN (default_channel_group = 'Paid Search' OR session_medium IN ('cpc', 'ppc', 'paidsearch'))
        AND REGEXP_CONTAINS(session_campaign, r'brand')
        THEN 'paid brand search'

      WHEN (default_channel_group = 'Paid Search')
        AND NOT REGEXP_CONTAINS(session_campaign, r'brand')
        THEN 'paid non-brand search'

      WHEN default_channel_group = 'Organic Search'
        THEN 'organic search'

      WHEN (
          default_channel_group = 'Paid Social'
          OR REGEXP_CONTAINS(session_source, r'facebook|twitter|youtube|instagram|reddit|fb|quora')
          OR session_medium = 'paidsocial'
        )
        AND session_medium != 'referral'
        THEN 'paid social'

      WHEN default_channel_group = 'Organic Social'
        THEN 'organic social'

      WHEN default_channel_group = 'Paid Video'
        OR session_medium = 'paidvideo'
        THEN 'paid video'

      WHEN default_channel_group = 'Organic Video'
        THEN 'organic video'

      WHEN default_channel_group = 'Paid Shopping'
        THEN 'paid shopping'

      WHEN default_channel_group = 'Organic Shopping'
        THEN 'organic shopping'

      WHEN default_channel_group = 'Display'
        OR session_medium = 'paiddisplay'
        THEN 'paid display'

      WHEN default_channel_group = 'Cross-network'
        THEN 'cross-network'

      WHEN default_channel_group = 'Audio'
        THEN 'audio'

      WHEN default_channel_group = 'Mobile Push Notifications'
        OR REGEXP_CONTAINS(session_medium, r'push')
        THEN 'mobile push notifications'

      WHEN default_channel_group = 'Paid Other'
        THEN 'paid other'

      WHEN REGEXP_CONTAINS(session_medium, r'ads|pr|paidreferral')
        OR REGEXP_CONTAINS(session_source, r'capitaloneshopping')
        THEN 'paid referral'

      WHEN default_channel_group = 'Referral'
        OR REGEXP_CONTAINS(session_source, r'chatgpt')
        OR REGEXP_CONTAINS(session_medium, r'earnedreferral')
        THEN 'organic referral'

      WHEN default_channel_group = 'Direct'
        OR session_source = '(direct)' 
        OR session_medium IN ('(none)', 'none')
        THEN 'direct'

      WHEN REGEXP_CONTAINS(session_medium, r'tv|television|connectedtv')
        OR REGEXP_CONTAINS(session_source, r'mntn')
        THEN 'connected tv'

      ELSE 'unassigned'
    END AS base_channel
  FROM
    Session_With_Flags
),

-- 4. 最终渠道逻辑 (Final Mapping)
Session_Final_Mapped AS (
  SELECT
    date,
    user_pseudo_id,
    session_id,
    event_name,
    transaction_id,
    purchase_revenue_in_usd,
    session_engaged_param,
    
    -- 后缀拆分逻辑 (Pillar Page 和 Email 除外)
    CASE 
      WHEN base_channel IN ('pillar page', 'email') THEN base_channel
      WHEN is_paid_traffic THEN
        CASE 
          WHEN CONTAINS_SUBSTR(session_campaign, '-aw') THEN base_channel || ':branding'
          WHEN CONTAINS_SUBSTR(session_campaign, '-cs') THEN base_channel || ':traffic'
          WHEN CONTAINS_SUBSTR(session_campaign, '-cv') THEN base_channel || ':conversion'
          WHEN CONTAINS_SUBSTR(session_campaign, '-rt') THEN base_channel || ':retargeting'
          ELSE base_channel
        END
      ELSE base_channel 
    END AS channel
  FROM 
    Session_Base_Mapped
),

-- 5. 最终聚合 (Final Aggregation)
Final_Aggregation AS (
  SELECT
    channel,
    date,
    
    COUNT(DISTINCT session_id) AS sessions,
    COUNT(DISTINCT user_pseudo_id) AS users,
    
    COUNT(DISTINCT 
      CASE 
        WHEN event_name = 'purchase' 
          AND transaction_id IS NOT NULL 
        THEN transaction_id 
      END
    ) AS total_conversions,
    
    COALESCE(
      SUM(CASE WHEN event_name = 'purchase' THEN purchase_revenue_in_usd ELSE 0 END), 
      0
    ) AS total_revenue,
    
    COUNT(DISTINCT CASE WHEN session_engaged_param != '1' OR session_engaged_param IS NULL THEN session_id END) AS bounced_sessions
  FROM
    Session_Final_Mapped
  GROUP BY
    channel, date
   --- HAVING total_conversions > 0
)

-- 6. 最终输出计算 (Output Calculation)
-- 去掉了 HAVING total_conversions > 0，因为通常日报也需要看有流量但无转化的渠道数据
SELECT
  channel,
  date,
  
  total_conversions AS conversion,
  total_revenue AS revenue,
  sessions AS session,
  users,
  
  SAFE_DIVIDE(total_conversions, sessions) AS session_conversion_rate,
  SAFE_DIVIDE(total_conversions, users) AS user_conversion_rate,
  SAFE_DIVIDE(bounced_sessions, sessions) AS bounce_rate,
  SAFE_DIVIDE(total_revenue, users) AS revenue_per_user,
  SAFE_DIVIDE(total_revenue, total_conversions) AS average_order_value,
  SAFE_DIVIDE(total_revenue, sessions) AS revenue_per_session
FROM
  Final_Aggregation
