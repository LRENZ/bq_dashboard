config {
  type: "incremental",
  schema: "attribution",
  name: "channel_performance",
  description: "Daily channel performance with fixed session attribution inheritance (Pillar Page fix)",
  uniqueKey: ["date", "channel"],
  protected: true,
  bigquery: {
    partitionBy: "date",
    clusterBy: ["channel"],
    updatePartitionFilter: "date >= DATE_SUB(CURRENT_DATE('America/Los_Angeles'), INTERVAL 7 DAY)"
  },
  tags: ["attribution", "ga4", "last-click", "merged", "fixed"]
}

WITH Raw_Events AS (
  -- 1. 基础数据抽取
  SELECT 
    event_timestamp,
    event_name,
    user_pseudo_id,
    event_params,
    traffic_source,
    session_traffic_source_last_click,
    ecommerce,
    '310494624' as property_id,
    _TABLE_SUFFIX AS table_suffix
  FROM `bigquery-2024.analytics_310494624.events_*`
  WHERE _TABLE_SUFFIX < '20250728'

  UNION ALL

  SELECT 
    event_timestamp,
    event_name,
    user_pseudo_id,
    event_params,
    traffic_source,
    session_traffic_source_last_click,
    ecommerce,
    '489554557' as property_id,
    _TABLE_SUFFIX AS table_suffix
  FROM `bigquery-2024.analytics_489554557.events_*`
  WHERE _TABLE_SUFFIX >= '20250728'
),

Session_Windowed AS (
  -- 2. 窗口补全层：将 Event Scope 转化为 Session Scope
  -- 核心逻辑：使用 FIRST_VALUE 将会话开始时的来源和落地页，赋予会话内的所有事件(包括 Purchase)
  SELECT
    user_pseudo_id,
    property_id,
    CONCAT(user_pseudo_id, '-', property_id, '-', (SELECT value.int_value FROM UNNEST(event_params) WHERE key = 'ga_session_id')) AS unique_session_id,
    DATE(TIMESTAMP_MICROS(event_timestamp), "America/Los_Angeles") AS date,
    event_name,
    ecommerce.transaction_id,
    COALESCE(ecommerce.purchase_revenue_in_usd, 0) AS purchase_revenue_in_usd,

    -- 计算 Session Engaged
    MAX(
      CASE WHEN (SELECT value.string_value FROM UNNEST(event_params) WHERE key = 'session_engaged') = '1' THEN 1 ELSE 0 END
    ) OVER (PARTITION BY user_pseudo_id, property_id, (SELECT value.int_value FROM UNNEST(event_params) WHERE key = 'ga_session_id')) AS is_session_engaged,

    -- [关键] 构造 Session Scope 的 Source
    FIRST_VALUE(
      LOWER(COALESCE(
        session_traffic_source_last_click.cross_channel_campaign.source,
        (SELECT value.string_value FROM UNNEST(event_params) WHERE key = 'source')
      )) IGNORE NULLS
    ) OVER (
      PARTITION BY user_pseudo_id, property_id, (SELECT value.int_value FROM UNNEST(event_params) WHERE key = 'ga_session_id')
      ORDER BY event_timestamp
      ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING
    ) AS session_source,
    
    -- [关键] 构造 Session Scope 的 Medium
    FIRST_VALUE(
      LOWER(COALESCE(
        session_traffic_source_last_click.cross_channel_campaign.medium,
        (SELECT value.string_value FROM UNNEST(event_params) WHERE key = 'medium')
      )) IGNORE NULLS
    ) OVER (
      PARTITION BY user_pseudo_id, property_id, (SELECT value.int_value FROM UNNEST(event_params) WHERE key = 'ga_session_id')
      ORDER BY event_timestamp
      ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING
    ) AS session_medium,
    
    -- [关键] 构造 Session Scope 的 Campaign
    FIRST_VALUE(
      LOWER(COALESCE(
        session_traffic_source_last_click.cross_channel_campaign.campaign_name,
        (SELECT value.string_value FROM UNNEST(event_params) WHERE key = 'campaign')
      )) IGNORE NULLS
    ) OVER (
      PARTITION BY user_pseudo_id, property_id, (SELECT value.int_value FROM UNNEST(event_params) WHERE key = 'ga_session_id')
      ORDER BY event_timestamp
      ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING
    ) AS session_campaign,

    -- [关键] 构造 Session Scope 的 Channel Group
    FIRST_VALUE(
      session_traffic_source_last_click.cross_channel_campaign.default_channel_group IGNORE NULLS
    ) OVER (
      PARTITION BY user_pseudo_id, property_id, (SELECT value.int_value FROM UNNEST(event_params) WHERE key = 'ga_session_id')
      ORDER BY event_timestamp
      ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING
    ) AS raw_channel_group,

    -- [关键] 构造 Session Scope 的 Landing Page (落地页)
    FIRST_VALUE(
      CASE WHEN event_name IN ('session_start', 'page_view') THEN
        LOWER((SELECT value.string_value FROM UNNEST(event_params) WHERE key = 'page_location'))
      END IGNORE NULLS
    ) OVER (
      PARTITION BY user_pseudo_id, property_id, (SELECT value.int_value FROM UNNEST(event_params) WHERE key = 'ga_session_id')
      ORDER BY event_timestamp
      ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING
    ) AS landing_page

  FROM Raw_Events
  WHERE
    ${when(incremental(),
      `table_suffix >= FORMAT_DATE('%Y%m%d', DATE_SUB(CURRENT_DATE("America/Los_Angeles"), INTERVAL 7 DAY))`,
      `table_suffix >= FORMAT_DATE('%Y%m%d', DATE_SUB(CURRENT_DATE("America/Los_Angeles"), INTERVAL 1080 DAY))`
    )}
    AND (SELECT value.int_value FROM UNNEST(event_params) WHERE key = 'ga_session_id') IS NOT NULL
),

Session_Cleaned AS (
  SELECT 
    *,
    COALESCE(session_source, '(direct)') as final_source,
    COALESCE(session_medium, '(none)') as final_medium,
    COALESCE(session_campaign, '(not set)') as final_campaign,
    COALESCE(raw_channel_group, 'Unassigned') as default_channel_group
  FROM Session_Windowed
),

Session_With_Flags AS (
  SELECT
    *,
    -- 这个 Flag 现在是完全基于 Session Scope 的 Medium 判断的
    CASE 
      WHEN REGEXP_CONTAINS(default_channel_group, r'Paid') THEN TRUE
      WHEN default_channel_group = 'Display' THEN TRUE
      WHEN REGEXP_CONTAINS(final_medium, r'^(cpc|ppc|display|cpm|banner)$') THEN TRUE
      WHEN final_medium LIKE '%paid%' THEN TRUE
      ELSE FALSE
    END AS is_initial_paid_flag
  FROM Session_Cleaned
),

Session_Base_Mapped AS (
  SELECT
    *,
    CASE
      -- Pillar Page 判定：
      -- 1. 使用 is_initial_paid_flag (Session Scope 的付费标记)
      -- 2. 使用 landing_page (Session Scope 的落地页)
      -- 这样就实现了将 Pillar Page 作为 Session Scope 处理
      WHEN is_initial_paid_flag 
           AND REGEXP_CONTAINS(landing_page, r'/pages/(what-is-an-ebike|cruiser-ebike|folding-ebike|city-ebike|fat-tire-ebike)')
      THEN 'pillar page'

      WHEN default_channel_group = 'Affiliates'
        OR REGEXP_CONTAINS(final_medium, r'affiliate|avantlink|uppromote|goaffpro|impact')
        OR REGEXP_CONTAINS(final_source, r'affiliate|avantlink|uppromote|goaffpro|impact')
        THEN 'affiliates'

      WHEN default_channel_group = 'SMS'
        OR REGEXP_CONTAINS(final_medium, r'sms')
        THEN 'sms'

      WHEN default_channel_group = 'Email'
        OR REGEXP_CONTAINS(final_source, r'klaviyo|email|substack|wunderkind')
        OR final_medium = 'edm'
        THEN 'email'

      WHEN REGEXP_CONTAINS(final_medium, r'kol')
        OR final_source = 'kol'
        THEN 'kol'

      WHEN final_medium = 'programmatic'
        OR REGEXP_CONTAINS(final_source, r'ttd|outbrain|loopme|criteo|tradedesk')
        THEN 'programmatic ads'

      WHEN (default_channel_group = 'Paid Search' OR final_medium IN ('cpc', 'ppc', 'paidsearch'))
        AND REGEXP_CONTAINS(final_campaign, r'brand')
        THEN 'paid brand search'

      WHEN (default_channel_group = 'Paid Search')
        AND NOT REGEXP_CONTAINS(final_campaign, r'brand')
        THEN 'paid non-brand search'

      WHEN default_channel_group = 'Organic Search'
        THEN 'organic search'

      WHEN (
          default_channel_group = 'Paid Social'
          OR REGEXP_CONTAINS(final_source, r'facebook|twitter|youtube|instagram|reddit|fb|quora')
          OR final_medium = 'paidsocial'
        )
        AND final_medium != 'referral'
        THEN 'paid social'

      WHEN default_channel_group = 'Organic Social'
        THEN 'organic social'

      WHEN default_channel_group = 'Paid Video'
        OR final_medium = 'paidvideo'
        THEN 'paid video'

      WHEN default_channel_group = 'Organic Video'
        THEN 'organic video'

      WHEN default_channel_group = 'Paid Shopping'
        THEN 'paid shopping'

      WHEN default_channel_group = 'Organic Shopping'
        THEN 'organic shopping'

      WHEN default_channel_group = 'Display'
        OR final_medium = 'paiddisplay'
        THEN 'paid display'

      WHEN default_channel_group = 'Cross-network'
        THEN 'cross-network'

      WHEN default_channel_group = 'Audio'
        THEN 'audio'

      WHEN default_channel_group = 'Mobile Push Notifications'
        OR REGEXP_CONTAINS(final_medium, r'push')
        THEN 'mobile push notifications'

      WHEN default_channel_group = 'Paid Other'
        THEN 'paid other'

      WHEN REGEXP_CONTAINS(final_medium, r'ads|pr|paidreferral')
        THEN 'paid referral'

      WHEN default_channel_group = 'Referral'
        OR REGEXP_CONTAINS(final_source, r'chatgpt')
        OR REGEXP_CONTAINS(final_medium, r'earnedreferral')
        THEN 'organic referral'

      WHEN default_channel_group = 'Direct'
        OR final_source = '(direct)' 
        OR final_medium IN ('(none)', 'none')
        THEN 'direct'

      WHEN REGEXP_CONTAINS(final_medium, r'tv|television|connectedtv')
        OR REGEXP_CONTAINS(final_source, r'mntn')
        THEN 'connected tv'

      ELSE 'unassigned'
    END AS base_channel
  FROM
    Session_With_Flags
),

Session_Final_Mapped AS (
  SELECT
    date,
    unique_session_id,
    user_pseudo_id, -- [修复] 加上了 user_pseudo_id，防止 Unrecognized name 错误
    event_name,
    transaction_id,
    purchase_revenue_in_usd,
    is_session_engaged,
    
    CASE 
      WHEN base_channel IN ('pillar page', 'email', 'sms', 'affiliates', 'unassigned','kol') THEN base_channel
      
      WHEN is_initial_paid_flag 
           OR REGEXP_CONTAINS(base_channel, r'^paid') 
           OR base_channel IN ('programmatic ads', 'connected tv', 'display', 'cross-network') 
      THEN
        CASE 
          WHEN CONTAINS_SUBSTR(final_campaign, '-aw') THEN base_channel || ':branding'
          WHEN CONTAINS_SUBSTR(final_campaign, '-cs') THEN base_channel || ':traffic'
          WHEN CONTAINS_SUBSTR(final_campaign, '-cv') THEN base_channel || ':conversion'
          WHEN CONTAINS_SUBSTR(final_campaign, '-rt') THEN base_channel || ':retargeting'
          ELSE base_channel || ':conversion'
        END
      
      ELSE base_channel 
    END AS channel
  FROM 
    Session_Base_Mapped
),

Final_Aggregation AS (
  SELECT
    channel,
    date,
    
    COUNT(DISTINCT unique_session_id) AS sessions,
    COUNT(DISTINCT user_pseudo_id) AS users, -- 现在可以正常计算了
    
    COUNT(DISTINCT 
      CASE 
        WHEN event_name = 'purchase' 
          AND transaction_id IS NOT NULL 
        THEN transaction_id 
      END
    ) AS total_conversions,
    
    COALESCE(
      SUM(CASE WHEN event_name = 'purchase' THEN purchase_revenue_in_usd ELSE 0 END), 
      0
    ) AS total_revenue,
    
    COUNT(DISTINCT CASE WHEN is_session_engaged = 0 THEN unique_session_id END) AS bounced_sessions
  FROM
    Session_Final_Mapped
  GROUP BY
    channel, date
)

SELECT
  channel,
  date,
  
  total_conversions AS conversion,
  total_revenue AS revenue,
  sessions AS session,
  users,
  
  SAFE_DIVIDE(total_conversions, sessions) AS session_conversion_rate,
  SAFE_DIVIDE(total_conversions, users) AS user_conversion_rate,
  SAFE_DIVIDE(bounced_sessions, sessions) AS bounce_rate,
  SAFE_DIVIDE(total_revenue, users) AS revenue_per_user,
  SAFE_DIVIDE(total_revenue, total_conversions) AS average_order_value,
  SAFE_DIVIDE(total_revenue, sessions) AS revenue_per_session
FROM
  Final_Aggregation
