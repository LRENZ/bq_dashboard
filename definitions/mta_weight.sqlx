config {
  type: "table",
  schema: "attribution_v1",
  name: "mta_weights_complete",
  description: "Complete daily MTA weights covering all reporting channels by weight_date",
  tags: ["attribution", "mta", "complete"]
}

WITH Report_Date_Channels AS (
  SELECT
    date AS weight_date,
    channel
  FROM
    `bigquery-2024.attribution.channel_performance`
  WHERE
    date >= DATE_SUB(CURRENT_DATE("America/Los_Angeles"), INTERVAL 1080 DAY)
),

Daily_Markov_Weights AS (
  SELECT
    weight_date,
    channel,
    weight AS markov_weight,
    removal_effect,
    window_start_date,
    window_end_date,
    run_timestamp
  FROM
    `bigquery-2024.attribution_v1.mta_markov_weights_daily`
  WHERE
    weight_date >= DATE_SUB(CURRENT_DATE("America/Los_Angeles"), INTERVAL 1080 DAY)
  QUALIFY
    ROW_NUMBER() OVER (
      PARTITION BY weight_date, channel
      ORDER BY run_timestamp DESC, window_end_date DESC
    ) = 1
),

Performance_Stats AS (
  SELECT
    date AS weight_date,
    channel,
    SUM(conversion) AS performance_conversions,
    SUM(revenue) AS performance_revenue,
    SUM(session) AS performance_sessions,
    SUM(users) AS performance_users
  FROM
    `bigquery-2024.attribution.channel_performance`
  WHERE
    date >= DATE_SUB(CURRENT_DATE("America/Los_Angeles"), INTERVAL 1080 DAY)
  GROUP BY
    weight_date,
    channel
),

Combined_Data AS (
  SELECT
    rdc.weight_date,
    rdc.channel,
    COALESCE(mw.markov_weight, 0) AS markov_weight,
    COALESCE(mw.removal_effect, 0) AS removal_effect,
    mw.window_start_date,
    mw.window_end_date,
    0 AS journey_conversions,
    0 AS journey_revenue,
    0 AS journey_users,
    COALESCE(ps.performance_conversions, 0) AS performance_conversions,
    COALESCE(ps.performance_revenue, 0) AS performance_revenue,
    COALESCE(ps.performance_sessions, 0) AS performance_sessions,
    COALESCE(ps.performance_users, 0) AS performance_users,
    mw.run_timestamp
  FROM
    Report_Date_Channels rdc
  LEFT JOIN Daily_Markov_Weights mw
    ON rdc.weight_date = mw.weight_date
    AND rdc.channel = mw.channel
  LEFT JOIN Performance_Stats ps
    ON rdc.weight_date = ps.weight_date
    AND rdc.channel = ps.channel
),

Final_Weights AS (
  SELECT
    weight_date,
    channel,
    markov_weight AS original_markov_weight,
    removal_effect,
    window_start_date,
    window_end_date,
    COALESCE(markov_weight, 0) AS raw_weight,
    journey_conversions,
    journey_revenue,
    journey_users,
    performance_conversions,
    performance_revenue,
    performance_sessions,
    performance_users,
    run_timestamp
  FROM
    Combined_Data
),

Normalized_Weights AS (
  SELECT
    weight_date,
    channel,
    original_markov_weight,
    removal_effect,
    window_start_date,
    window_end_date,
    CASE
      WHEN SUM(removal_effect) OVER (PARTITION BY weight_date) > 0
      THEN SAFE_DIVIDE(removal_effect, SUM(removal_effect) OVER (PARTITION BY weight_date))
      ELSE 0
    END AS normalized_removal_effect,
    raw_weight,
    CASE
      WHEN SUM(raw_weight) OVER (PARTITION BY weight_date) > 0
      THEN SAFE_DIVIDE(raw_weight, SUM(raw_weight) OVER (PARTITION BY weight_date))
      ELSE 0
    END AS normalized_weight,
    CASE
      WHEN raw_weight > 0 THEN 'Markov Chain'
      ELSE 'No Markov Weight (Zero)'
    END AS weight_source,
    journey_conversions,
    journey_revenue,
    journey_users,
    performance_conversions,
    performance_revenue,
    performance_sessions,
    performance_users,
    run_timestamp
  FROM
    Final_Weights
)

SELECT
  weight_date AS Weight_Date,
  channel,
  normalized_weight AS Weight,
  original_markov_weight AS Original_Markov_Weight,
  normalized_removal_effect AS Removal_Effect,
  weight_source AS Weight_Source,
  window_start_date AS Window_Start_Date,
  window_end_date AS Window_End_Date,
  journey_conversions AS Journey_Conversions,
  journey_revenue AS Journey_Revenue,
  performance_conversions AS Performance_Conversions,
  performance_revenue AS Performance_Revenue,
  journey_users AS Journey_Users,
  performance_users AS Performance_Users,
  performance_sessions AS Performance_Sessions,
  run_timestamp AS Markov_Run_Timestamp,
  CURRENT_TIMESTAMP() AS Created_Timestamp
FROM
  Normalized_Weights
ORDER BY
  Weight_Date DESC,
  normalized_weight DESC
