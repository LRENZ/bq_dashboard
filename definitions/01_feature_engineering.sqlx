config {
  type: "table", 
  schema: "dataform_ml",
  description: "用户级别的特征表，用于训练线下意向模型",
  tags: ["ml_preprocessing"]
}

WITH UserAggregated AS (
  SELECT
    unified_user_id,
    
    -- 【地理特征】
    COALESCE(APPROX_TOP_COUNT(region, 1)[OFFSET(0)].value, 'Unknown') AS region,
    
    -- 【渠道特征】
    ARRAY_AGG(channel ORDER BY event_timestamp_obj DESC LIMIT 1)[OFFSET(0)] AS last_touch_channel,
    
    -- 【时间特征 - 修复点】
    -- 1. 生成 interaction_date 供过滤使用
    DATE(MAX(event_timestamp_obj), "America/Los_Angeles") AS interaction_date,
    -- 2. 生成 Month 供模型学习季节性
    EXTRACT(MONTH FROM MAX(event_timestamp_obj)) AS month,
    -- 3. 生成 Day of Week
    EXTRACT(DAYOFWEEK FROM MAX(event_timestamp_obj)) AS day_of_week,
    
    -- 【活跃度特征 - 修复点】
    -- 重命名为 interaction_count 以匹配 ML 脚本
    COUNT(*) AS interaction_count,
    SUM(CASE WHEN is_paid_traffic THEN 1 ELSE 0 END) AS paid_interactions_count,

    -- 【Label 目标变量】
    MAX(visited_find_dealer) AS has_offline_intent

  FROM
    ${ref("session_source_medium_country")} 
  GROUP BY
    unified_user_id
)

SELECT
  *
FROM
  UserAggregated
WHERE
  last_touch_channel IS NOT NULL 
  AND region != 'Unknown'