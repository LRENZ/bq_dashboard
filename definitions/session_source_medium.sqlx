config {
  type: "table",
  schema: "attribution",
  name: "session_source_medium",
  description: "User journey data with all channel touchpoints for attribution modeling"
}

-- ============================================================================
-- 多渠道归因数据准备 SQL
-- 目标：为 Python 归因模型提供完整的用户渠道旅程数据
-- 必需字段：unified_user_id, channel, event_date, total_transactions, total_transaction_value
-- ============================================================================

-- 1. 事件层数据提取
WITH SessionEvents AS (
  WITH RawEvents AS (
    SELECT
      *,
      (SELECT value.string_value FROM UNNEST(event_params) WHERE key = 'page_location') AS page_location
    FROM
      ${ref('analytics_489554557', 'events_*')}
    WHERE
      event_name IN ('purchase', 'session_start', 'first_visit', 'page_view')
      -- [修改] 移除了 revenue = 0 的排除逻辑
      -- 限制时间范围以提高性能
      AND _TABLE_SUFFIX BETWEEN FORMAT_DATE('%Y%m%d', DATE_SUB(CURRENT_DATE(), INTERVAL 90 DAY))
                             AND FORMAT_DATE('%Y%m%d', CURRENT_DATE())
  )
  SELECT
    -- 统一用户ID
    COALESCE(
      LAST_VALUE(raw.user_id IGNORE NULLS) OVER (
        PARTITION BY raw.user_pseudo_id 
        ORDER BY raw.event_timestamp 
        ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING
      ),
      raw.user_pseudo_id
    ) AS unified_user_id,
    
    raw.event_timestamp,
    raw.event_name,
    
    -- 默认渠道组 (GA4 原生定义)
    raw.session_traffic_source_last_click.cross_channel_campaign.default_channel_group AS default_channel_group,

    -- [修改] 统一转为小写 (Source)
    LOWER(COALESCE(
      raw.session_traffic_source_last_click.cross_channel_campaign.source,
      (SELECT value.string_value FROM UNNEST(event_params) WHERE key = 'source'),
      '(direct)'
    )) AS source,
    
    -- [修改] 统一转为小写 (Medium)
    LOWER(COALESCE(
      raw.session_traffic_source_last_click.cross_channel_campaign.medium,
      (SELECT value.string_value FROM UNNEST(event_params) WHERE key = 'medium'),
      '(none)'
    )) AS medium,
    
    -- [修改] 统一转为小写 (Campaign)
    LOWER(COALESCE(
      raw.session_traffic_source_last_click.cross_channel_campaign.campaign_name,
      (SELECT value.string_value FROM UNNEST(event_params) WHERE key = 'campaign'),
      '(not set)'
    )) AS campaign,
    
    -- Page Location 也转小写方便匹配
    LOWER(raw.page_location) AS page_location,
    
    raw.ecommerce.transaction_id,
    COALESCE(raw.ecommerce.purchase_revenue_in_usd, 0) AS transaction_value
  FROM
    RawEvents AS raw
),

-- 2. 渠道映射
AllTouchpoints AS (
  SELECT
    unified_user_id,
    event_timestamp,
    event_name,
    source,
    medium,
    campaign, -- [修改] 保留 campaign 用于后续输出
    
    -- 渠道分类逻辑 (注意：source/medium/campaign 已经是小写)
    -- 输出的渠道名称也统一改为小写
    CASE
      -- ======================================================================
      -- 规则 3: Pillar Page (优先级最高)
      -- 定义: campaign 包含指定标签 (改为 -) 且 访问特定页面
      -- ======================================================================
      WHEN REGEXP_CONTAINS(campaign, r'-aw|-cs|-cv|-rt')
           AND REGEXP_CONTAINS(page_location, r'/pages/(what-is-an-ebike|cruiser-ebike|folding-ebike|city-ebike|fat-tire-ebike)')
      THEN 'pillar page'

      -- ======================================================================
      -- 规则 1: 自定义 Paid Ads 渠道
      -- 定义: 基于 campaign 后缀 (改为 -)
      -- ======================================================================
      WHEN CONTAINS_SUBSTR(campaign, '-aw') THEN 'paid_ads:branding'
      WHEN CONTAINS_SUBSTR(campaign, '-cs') THEN 'paid_ads:traffic'
      WHEN CONTAINS_SUBSTR(campaign, '-cv') THEN 'paid_ads:conversion'
      WHEN CONTAINS_SUBSTR(campaign, '-rt') THEN 'paid_ads:retargeting'

      -- ======================================================================
      -- 规则 4 & 2: 基于 JSON 定义和 GA4 Default Channel Group 的映射
      -- ======================================================================
      
      -- Affiliates
      WHEN default_channel_group = 'Affiliates'
        OR REGEXP_CONTAINS(medium, r'affiliate|avantlink|uppromote|goaffpro|impact')
        OR REGEXP_CONTAINS(source, r'affiliate|avantlink|uppromote|goaffpro|impact')
        THEN 'affiliates'

      -- SMS
      WHEN default_channel_group = 'SMS'
        OR REGEXP_CONTAINS(medium, r'sms')
        THEN 'sms'

      -- Email
      WHEN default_channel_group = 'Email'
        OR REGEXP_CONTAINS(source, r'klaviyo|email|substack|wunderkind')
        OR medium = 'edm'
        THEN 'email'

      -- KOL
      WHEN REGEXP_CONTAINS(medium, r'kol')
        OR source = 'kol'
        THEN 'kol'

      -- Programmatic Ads
      WHEN medium = 'programmatic'
        OR REGEXP_CONTAINS(source, r'ttd|outbrain|loopme|criteo|tradedesk')
        THEN 'programmatic ads'

      -- Paid Brand Search
      WHEN (default_channel_group = 'Paid Search' OR medium IN ('cpc', 'ppc', 'paidsearch'))
        AND REGEXP_CONTAINS(campaign, r'brand')
        THEN 'paid brand search'

      -- Paid Non-Brand Search
      WHEN (default_channel_group = 'Paid Search')
        AND NOT REGEXP_CONTAINS(campaign, r'brand')
        THEN 'paid non-brand search'

      -- Organic Search
      WHEN default_channel_group = 'Organic Search'
        THEN 'organic search'

      -- Paid Social
      WHEN (
          default_channel_group = 'Paid Social'
          OR REGEXP_CONTAINS(source, r'facebook|twitter|youtube|instagram|reddit|fb|quora')
          OR medium = 'paidsocial'
        )
        AND medium != 'referral'
        THEN 'paid social'

      -- Organic Social
      WHEN default_channel_group = 'Organic Social'
        THEN 'organic social'

      -- Paid Video
      WHEN default_channel_group = 'Paid Video'
        OR medium = 'paidvideo'
        THEN 'paid video'

      -- Organic Video
      WHEN default_channel_group = 'Organic Video'
        THEN 'organic video'

      -- Paid Shopping
      WHEN default_channel_group = 'Paid Shopping'
        THEN 'paid shopping'

      -- Organic Shopping
      WHEN default_channel_group = 'Organic Shopping'
        THEN 'organic shopping'

      -- Paid Display
      WHEN default_channel_group = 'Display'
        OR medium = 'paiddisplay'
        THEN 'paid display'

      -- Cross-network
      WHEN default_channel_group = 'Cross-network'
        THEN 'cross-network'

      -- Audio
      WHEN default_channel_group = 'Audio'
        THEN 'audio'

      -- Mobile Push Notifications
      WHEN default_channel_group = 'Mobile Push Notifications'
        OR REGEXP_CONTAINS(medium, r'push')
        THEN 'mobile push notifications'

      -- Paid Other
      WHEN default_channel_group = 'Paid Other'
        THEN 'paid other'

      -- Paid Referral
      WHEN REGEXP_CONTAINS(medium, r'ads|pr|paidreferral')
        OR REGEXP_CONTAINS(source, r'capitaloneshopping')
        THEN 'paid referral'

      -- Organic Referral
      WHEN default_channel_group = 'Referral'
        OR REGEXP_CONTAINS(source, r'chatgpt')
        OR REGEXP_CONTAINS(medium, r'earnedreferral')
        THEN 'organic referral'

      -- Direct
      WHEN default_channel_group = 'Direct'
        OR source = '(direct)' 
        OR medium IN ('(none)', 'none')
        THEN 'direct'

      -- Connected TV
      WHEN REGEXP_CONTAINS(medium, r'tv|television|connectedtv')
        OR REGEXP_CONTAINS(source, r'mntn')
        THEN 'connected tv'

      -- Unassigned
      ELSE 'unassigned'
    END AS channel,
    
    -- 是否付费流量标识 (更新为 - 判断)
    CASE 
      WHEN REGEXP_CONTAINS(campaign, r'-aw|-cs|-cv|-rt') THEN TRUE
      WHEN medium LIKE '%cpc%' 
        OR medium LIKE '%paid%'
        OR medium IN ('ppc', 'display', 'cpm', 'banner', 'video', 'shopping')
        OR REGEXP_CONTAINS(source, r'capitaloneshopping') 
        THEN TRUE
      ELSE FALSE
    END AS is_paid_traffic,
    
    transaction_id,
    transaction_value
  FROM
    SessionEvents
),

-- 3. 识别购买事件
PurchaseEvents AS (
  SELECT
    unified_user_id,
    transaction_id,
    event_timestamp AS purchase_timestamp,
    transaction_value,
    DATE(TIMESTAMP_MICROS(event_timestamp), "America/Los_Angeles") AS purchase_date,
    
    LAG(event_timestamp, 1, 0) OVER (
      PARTITION BY unified_user_id 
      ORDER BY event_timestamp
    ) AS previous_purchase_timestamp
  FROM
    AllTouchpoints
  WHERE
    transaction_id IS NOT NULL
    -- [修改] 移除了 > 0 的判断
    AND DATE(TIMESTAMP_MICROS(event_timestamp), "America/Los_Angeles") >= 
        DATE_SUB(CURRENT_DATE("America/Los_Angeles"), INTERVAL 30 DAY)
),

-- 4. 构建用户购买旅程路径
TransactionJourneys AS (
  SELECT
    p.unified_user_id,
    p.transaction_id,
    p.purchase_date,
    p.transaction_value,
    
    -- 聚合该购买前的所有触点，[修改] 将 campaign 加入 STRUCT
    ARRAY_AGG(
      STRUCT(
        t.channel,
        t.event_name,
        t.event_timestamp,
        t.is_paid_traffic,
        t.source,
        t.medium,
        t.campaign
      ) 
      ORDER BY t.event_timestamp
    ) AS touchpoint_path
  FROM
    PurchaseEvents AS p
  JOIN
    AllTouchpoints AS t
    ON p.unified_user_id = t.unified_user_id
  WHERE
    -- 只包含本次购买旅程中的触点
    t.event_timestamp > p.previous_purchase_timestamp
    AND t.event_timestamp <= p.purchase_timestamp
  GROUP BY
    1, 2, 3, 4
),

-- 5. 展开路径为行级数据
ExpandedPath AS (
  SELECT
    t.unified_user_id,
    TIMESTAMP_MICROS(touchpoint.event_timestamp) AS event_date,
    touchpoint.event_name,
    touchpoint.channel,
    touchpoint.is_paid_traffic,
    touchpoint.source,
    touchpoint.medium,
    touchpoint.campaign, -- [修改] 展开 campaign
    t.transaction_value,
    t.purchase_date,
    t.transaction_id
  FROM
    TransactionJourneys AS t
  CROSS JOIN
    UNNEST(t.touchpoint_path) AS touchpoint
),

-- 6. 标记购买事件并去重连续相同渠道
PathWithTransactions AS (
  SELECT
    unified_user_id,
    event_date,
    channel,
    is_paid_traffic,
    source,
    medium,
    campaign, -- [修改] 包含 campaign
    
    -- 标记是否为购买事件
    CASE WHEN event_name = 'purchase' THEN 1 ELSE 0 END AS total_transactions,
    CASE WHEN event_name = 'purchase' THEN transaction_value ELSE 0 END AS total_transaction_value,
    CASE WHEN event_name = 'purchase' THEN TRUE ELSE FALSE END AS has_transaction,
    
    -- 获取前一个渠道（用于去重）
    LAG(channel) OVER (
      PARTITION BY unified_user_id, transaction_id 
      ORDER BY event_date
    ) AS prev_channel,
    
    event_name,
    purchase_date,
    transaction_id
  FROM
    ExpandedPath
),

-- 7. 最终输出：去除连续重复渠道，保留购买事件
FinalOutput AS (
  SELECT
    unified_user_id,
    event_date,
    channel,
    is_paid_traffic,
    source,
    medium,
    campaign, -- [修改] 包含 campaign
    total_transactions,
    total_transaction_value,
    has_transaction,
    purchase_date,
    transaction_id
  FROM
    PathWithTransactions
  WHERE
    -- 保留以下情况：
    -- 1. 第一个触点
    -- 2. 渠道发生变化
    -- 3. 购买事件
    prev_channel IS NULL
    OR channel != prev_channel
    OR event_name = 'purchase'
)

-- 最终查询
SELECT
  unified_user_id,
  event_date,
  channel,
  is_paid_traffic,
  source,
  medium,
  campaign, -- [修改] 最终结果包含 campaign
  
  -- 聚合同一用户、同一渠道、同一天的数据
  SUM(total_transactions) AS total_transactions,
  SUM(total_transaction_value) AS total_transaction_value,
  
  MAX(has_transaction) AS has_transaction
FROM
  FinalOutput
GROUP BY
  unified_user_id,
  event_date,
  channel,
  is_paid_traffic,
  source,
  medium,
  campaign -- [修改] 增加分组