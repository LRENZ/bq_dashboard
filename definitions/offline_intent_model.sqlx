config {
  type: "operations",
  hasOutput: true,
  schema: "dataform_ml",
  tags: ["ml_training"]
}

CREATE OR REPLACE MODEL ${self()}
OPTIONS(
  model_type = 'LOGISTIC_REG', -- 逻辑回归用于分类
  input_label_cols = ['has_offline_intent'], -- 目标列
  auto_class_weights = TRUE, -- 自动处理正负样本不平衡
  data_split_method = 'AUTO_SPLIT', -- 自动划分训练集/测试集
  enable_global_explain = TRUE -- 允许查看特征重要性
) AS
SELECT
  -- 选择用于训练的特征
  region,
  last_touch_channel,
  day_of_week,
  month,
  interaction_count,
  has_offline_intent -- Label
FROM
  ${ref("01_feature_engineering")}
WHERE
  -- 仅使用过去的数据进行训练 (可选，防止使用今日数据训练今日模型)
  interaction_date < CURRENT_DATE("America/Los_Angeles")